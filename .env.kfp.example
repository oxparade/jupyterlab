# Kubeflow submit + watch defaults
# Copy to .env.kfp and adjust values to your environment.

KFP_NAMESPACE=kubeflow-user-example-com
KFP_HOST=http://localhost:8081/pipeline
KFP_EXPERIMENT=Default
KFP_PIPELINE_PACKAGE=kubeflow_pipeline.yaml
PYTHON_BIN=/opt/venvs/mlops/bin/python

KFP_STRATEGY=short_memory
KFP_SPLIT_STRATEGY=recent_history
KFP_GOVERNANCE_DRY_RUN=true
MLFLOW_TRACKING_URI=http://mlflow-server.mlflow.svc.cluster.local:5000

KFP_POLL_SECONDS=15
KFP_MAX_POLLS=120
