name: electricity-forecaster

python_env: python_env.yaml

entry_points:
  train:
    parameters:
      data: {type: path, default: data/processed/train.parquet}
      validation: {type: path, default: data/processed/validation.parquet}
    command: "python3 train_mlflow.py --data {data} --validation {validation}"

  serve:
    parameters:
      run_id: {type: str}
      host: {type: str, default: 127.0.0.1}
      port: {type: int, default: 5001}
    command: "mlflow models serve -m runs:/{run_id}/model -h {host} -p {port} --env-manager local"

  predict:
    parameters:
      run_id: {type: str}
      data: {type: path, default: data/processed/test.parquet}
      reference_data: {type: path, default: data/processed/train.parquet}
      evidently_api_url: {type: str, default: ""}
      evidently_project_name: {type: str, default: electricity_forecaster}
      evidently_secret: {type: str, default: ""}
    command: "python3 predict_mlflow.py --model runs:/{run_id}/model --data {data} --reference-data {reference_data} --evidently-api-url {evidently_api_url} --evidently-project-name {evidently_project_name} --evidently-secret {evidently_secret}"

  register:
    parameters:
      train: {type: path, default: data/processed/train.parquet}
      validation: {type: path, default: data/processed/validation.parquet}
      model_name: {type: str, default: electricity_forecaster}
      first_strategy: {type: str, default: short_memory}
      second_strategy: {type: str, default: mixed}
    command: "python3 register.py --train {train} --validation {validation} --model-name {model_name} --first-strategy {first_strategy} --second-strategy {second_strategy}"

  promote:
    parameters:
      model_name: {type: str, default: electricity_forecaster}
      min_gain: {type: float, default: 0.02}
    command: "python3 promote.py --model-name {model_name} --min-gain {min_gain}"

  govern:
    parameters:
      model_name: {type: str, default: electricity_forecaster}
      min_gain: {type: float, default: 0.02}
      dry_run: {type: str, default: true}
    command: "python3 govern.py --model-name {model_name} --min-gain {min_gain} --dry-run {dry_run}"

  submit_kubeflow:
    parameters:
      host: {type: str, default: ""}
      token: {type: str, default: ""}
      cookies: {type: str, default: ""}
      namespace: {type: str, default: kubeflow}
      experiment_name: {type: str, default: electricity-forecaster}
      pipeline_package: {type: path, default: kubeflow_pipeline.yaml}
      ssl_ca_cert: {type: str, default: ""}
      source_dir: {type: str, default: /workspace/jupyterlab}
      raw_dataset_path: {type: str, default: shared/dataset/LD2011_2014_kwh.parquet}
      mlflow_tracking_uri: {type: str, default: ""}
      model_name: {type: str, default: electricity_forecaster}
      first_strategy: {type: str, default: short_memory}
      second_strategy: {type: str, default: mixed}
      strategy: {type: str, default: mixed}
      split_strategy: {type: str, default: full_history}
      min_gain: {type: float, default: 0.02}
      governance_dry_run: {type: str, default: false}
      enable_caching: {type: str, default: true}
    command: "python3 submit_kubeflow_run.py --host {host} --token {token} --cookies {cookies} --namespace {namespace} --experiment-name {experiment_name} --pipeline-package {pipeline_package} --compile-if-missing --insecure --source-dir {source_dir} --raw-dataset-path {raw_dataset_path} --mlflow-tracking-uri {mlflow_tracking_uri} --model-name {model_name} --first-strategy {first_strategy} --second-strategy {second_strategy} --strategy {strategy} --split-strategy {split_strategy} --min-gain {min_gain} --governance-dry-run {governance_dry_run} --enable-caching {enable_caching} --ssl-ca-cert {ssl_ca_cert}"

  main:
    parameters:
      strategy: {type: str, default: mixed}
      split_strategy: {type: str, default: full_history}
      host: {type: str, default: 127.0.0.1}
      port: {type: int, default: 5001}
    command: "python3 main.py --strategy {strategy} --split-strategy {split_strategy} --host {host} --port {port}"

  retrain_validate:
    parameters:
      trigger_source: {type: str, default: auto}
      strategy: {type: str, default: mixed}
      split_strategy: {type: str, default: full_history}
      register_model: {type: str, default: false}
      promote_model: {type: str, default: false}
      model_name: {type: str, default: electricity_forecaster}
      min_gain: {type: float, default: 0.02}
    command: "python3 retrain_validate.py --trigger-source {trigger_source} --strategy {strategy} --split-strategy {split_strategy} --register-model {register_model} --promote-model {promote_model} --model-name {model_name} --min-gain {min_gain}"
